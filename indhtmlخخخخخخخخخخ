            filter: brightness(0.95) opacity(0.25) contrast(1.1);
        }

        /* Ambient Video Overlay Grid */
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            background: radial-gradient(circle at center, transparent 20%, var(--bg-primary) 90%);
