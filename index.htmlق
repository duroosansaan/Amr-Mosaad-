/* ES Marketing Agency - Main JavaScript Logic        */
/* ================================================= */

document.addEventListener('DOMContentLoaded', () => {

    /* 1. Filter Functionality for Target Categories */
    const filterButtons = document.querySelectorAll('.filter-btn');
    const targetCards = document.querySelectorAll('.target-card');

    filterButtons.forEach(button => {
        button.addEventListener('click', () => {
            // Play click sound effect
            playClickSound();

            // Remove active class from all buttons and add to clicked one
            filterButtons.forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');

            const category = button.getAttribute('data-filter');

            targetCards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'block';
                    setTimeout(() => {
                        card.style.opacity = '1';
                        card.style.transform = 'scale(1)';
                    }, 50);
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        card.style.display = 'none';
                    }, 300);
                }
            });
        });
    });

    /* 2. Web Audio API for Interactive Sound Effects (SFX) */
    function playClickSound() {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();

            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(600, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.05);

            gain.gain.setValueAtTime(0.05, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start();
            osc.stop(ctx.currentTime + 0.05);
        } catch (e) {
            // Fallback if audio context is restricted by browser policy
            console.log("Audio not allowed yet");
        }
    }

    // Attach click sound to all interactive buttons & links
    const interactiveElements = document.querySelectorAll('button, a, .filter-btn, .package-card');
    interactiveElements.forEach(el => {
        el.addEventListener('click', () => {
            playClickSound();
        });
    });

    /* 3. Form Submission Handling */
    const agencyForm = document.getElementById('agencyForm');
    if (agencyForm) {
        agencyForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            // Success feedback animation / alert
            alert('تم إرسال طلبك بنجاح إلى ES Marketing Agency! سيتم التواصل معك في أقرب وقت.');
            agencyForm.reset();
        });
    }

    /* 4. Mobile Menu Toggle */
    const menuToggle = document.getElementById('menuToggle');
    const mainNav = document.querySelector('.main-nav');

    if (menuToggle && mainNav) {
        menuToggle.addEventListener('click', () => {
            if (mainNav.style.display === 'flex') {
                mainNav.style.display = 'none';
            } else {
                mainNav.style.display = 'flex';
                mainNav.style.flexDirection = 'column';
                mainNav.style.position = 'absolute';
                mainNav.style.top = '80px';
                mainNav.style.right = '0';
                mainNav.style.width = '100%';
                mainNav.style.background = 'rgba(11, 15, 25, 0.95)';
                mainNav.style.padding = '20px';
                mainNav.style.borderBottom = '1px solid rgba(255,255,255,0.08)';
            }
        });
    }

});
