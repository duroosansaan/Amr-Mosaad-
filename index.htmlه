            { step: "02", title: "التصميم والرسم البصري", desc: "نرسم العناصر والشخصيات أو نجهز لوحة التصاميم المتناسقة مع هويتك البصرية." },
            { step: "03", title: "التحريك والمونتاج والصوت", desc: "نضيف الحركة المؤثرة والمؤثرات الصوتية والتعليق الصوتي والنصوص التفاعلية." },
            { step: "04", title: "المراجعة والتسليم النهائي", desc: "نعرض النسخة الأولى، ننفذ أي تعديلات مطلوبة، ونسلم الملفات بجودة عالي الدقة HD." }
        ];

        const SERVICES = [
            { id: "s1", title: "Pure Animation (أنيميشن كامل)", price: 650, unit: "للدقيقة", badge: "الأعلى طلباً", desc: "فيديو أنيميشن وموشن جرافيك مخصص بالكامل من الفكرة والسكريبت ورسم الشخصيات والتحريك." },
            { id: "s2", title: "Mixed with Pic (دمج صور وأنيميشن)", price: 580, unit: "للدقيقة", badge: "متميز للمتاجر", desc: "دمج احترافي بين صور المنتجات أو العناصر الحقيقية مع لمسات أنيميشن ومؤثرات كرتونية." },
            { id: "s3", title: "Pictures + Words (تحريك صور ونصوص)", price: 480, unit: "للدقيقة", badge: "اقتصادي وسريع", desc: "عرض حركي سريع مخصص للإعلانات عبر تحريك النصوص والمنتجات بأسلوب جذّاب." },
            { id: "s4", title: "Design / Static Post (تصميم إعلاني ثابت)", price: 180, unit: "للتصميم", badge: "تصميم ثابت", desc: "تصميم إعلاني ثابت للسوشيال ميديا متناسق الهوية ومصمم خصيصاً لزيادة المبيعات." },
            { id: "s5", title: "مونتاج Reels & Shorts احترافي", price: 350, unit: "للفيديو", badge: "تريند", desc: "مونتاج وإضافة نصوص حركية (Subtitles) ومؤثرات صوتية للفيديوهات الطولية لزيادة الانتشار." },
            { id: "s6", title: "تصميم هوية بصرية متكاملة (Branding)", price: 2500, unit: "للمشروع", badge: "شامل", desc: "بناء الهوية البصرية للشركات: الشعار، الألوان، الخطوط، ونماذج المطبوعات والتطبيقات." }
        ];

        const PACKS = [
            { id: "p1", name: "عرض 12 Reels + 60 Posts", price: 9000, recommended: true, badge: "العرض الشامل الكبير", feats: ["12 فيديو Reels احترافي", "60 تصميم منشور ثابت", "تغطية تسويقية متكاملة ومكثفة", "أولوية مطلقة في التنفيذ"] },
            { id: "p2", name: "عرض 8 Reels + 30 Posts", price: 5000, recommended: false, badge: "الأكثر طلباً", feats: ["8 فيديوهات Reels تفاعلية", "30 تصميم منشور ثابت", "مناسب للمشروعات الناشئة", "جدول زمني مرن"] },
            { id: "p3", name: "عرض 4 Reels + 16 Post", price: 2500, recommended: false, feats: ["4 فيديوهات Reels إعلانية", "16 تصميم منشور ثابت", "بداية ممتازة للحملات الإعلانية", "هوية بصرية متناسقة"] }
        ];

        const TARGET_CATEGORIES = [
            { title: "Hotels / Startups", sub: "الفنادق والشركات الناشئة", items: [{ img: "https://picsum.photos/800/800?random=101", tag: "نتائج فندقية 1" }, { img: "https://picsum.photos/800/800?random=102", tag: "نتائج فندقية 2" }] },
            { title: "Doctors Clinics", sub: "عيادات الأطباء والمراكز الطبية", items: [{ img: "https://picsum.photos/800/800?random=301", tag: "بوست طبّي 1" }, { img: "https://picsum.photos/800/800?random=302", tag: "بوست طبّي 2" }] },
            { title: "Restaurants & Coffees", sub: "المطاعم والكافيهات", items: [{ img: "https://picsum.photos/800/800?random=601", tag: "إعلان مطعم 1" }, { img: "https://picsum.photos/800/800?random=602", tag: "إعلان مطعم 2" }] }
        ];

        const PORTFOLIO_ITEMS = [
            { id: 1, type: "video", img: "https://picsum.photos/800/800?random=10", title: "إعلان مطعم أنيميشن" },
            { id: 2, type: "design", img: "https://picsum.photos/800/800?random=11", title: "تصميم سوشيال ميديا لعيادة" },
            { id: 3, type: "branding", img: "https://picsum.photos/800/800?random=12", title: "هوية بصرية لشركة عقارية" },
            { id: 4, type: "video", img: "https://picsum.photos/800/800?random=13", title: "ريلز إعلاني لمنتج" }
        ];

        const FAQS = [
            { q: "ما هي طرق الدفع المتاحة للتعاقد؟", a: "نوفر طرق دفع سهلة تشمل InstaPay، فودافون كاش، والتحويل البنكي. يتم دفع 50% عربون لبدء العمل والمتبقي عند الاستلام النهائي." },
            { q: "هل تقومون بكتابة سكريبت الإعلان والسيناريو؟", a: "نعم، كافة خدمات الفيديوهات تشمل كتابة سكريبت إعلاني احترافي مخصص لجمهورك." },
            { q: "ماذا لو أردت تعديلات على التصميم أو الفيديو؟", a: "نوفر تعديلاً مجانياً شاملاً بعد استلام النسخة الأولى لضمان رضاك الكامل." }
        ];

        const playClickSound = () => {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine'; osc.frequency.setValueAtTime(650, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(850, audioCtx.currentTime + 0.04);
                gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(); osc.stop(audioCtx.currentTime + 0.04);
            } catch (e) {}
        };

        function MainApp() {
            const [isLoading, setIsLoading] = useState(true);
            const [darkMode, setDarkMode] = useState(false);
            const [portfolioFilter, setPortfolioFilter] = useState('all');
            const [lightboxImg, setLightboxImg] = useState(null);
            const [openFaqIndex, setOpenFaqIndex] = useState(null);
            
            // Calculator State
            const [calcService, setCalcService] = useState('s1');
            const [calcQty, setCalcQty] = useState(1);
            const [calcFast, setCalcFast] = useState(false);

            useEffect(() => {
                setTimeout(() => setIsLoading(false), 1000);
                if (window.lucide) window.lucide.createIcons();
            }, [darkMode, portfolioFilter, lightboxImg, openFaqIndex, calcService, calcQty, calcFast]);

            const toggleDarkMode = () => {
                playClickSound();
                setDarkMode(!darkMode);
            };

            const openMessenger = () => {
                playClickSound();
                window.open(AGENCY_CONFIG.social.messenger, '_blank');
            };

            const calculatedTotal = useMemo(() => {
                const s = SERVICES.find(x => x.id === calcService);
                if (!s) return 0;
                let base = s.price * calcQty;
                if (calcFast) base += 250;
                return base;
            }, [calcService, calcQty, calcFast]);

            if (isLoading) {
                return (
                    <div className="loader-bg">
                        <div className="w-16 h-16 rounded-2xl bg-white text-black font-black text-3xl flex items-center justify-center mb-4 animate-bounce">ES</div>
                        <div className="text-white font-bold tracking-widest text-xs animate-pulse">ES AGENCY ... جاري التحميل</div>
                    </div>
                );
            }

            const cardClass = darkMode ? "bw-card-dark" : "bw-card-light";
            const glassClass = darkMode ? "bw-glass-dark text-white" : "bw-glass-light text-zinc-900";
            const bgClass = darkMode ? "bg-zinc-950 text-white" : "bg-white text-zinc-900";
            const borderClass = darkMode ? "border-zinc-800" : "border-zinc-200";

            return (
                <div className={`${bgClass} min-h-screen relative pb-20 font-sans transition-colors duration-300`}>
                    
                    {/* Header Nav */}
                    <nav className={`sticky top-0 z-40 ${glassClass} px-4 md:px-8 py-3.5 flex justify-between items-center`}>
                        <a href="#" className="flex items-center gap-2">
                            <div className={`w-10 h-10 rounded-lg ${darkMode ? 'bg-white text-black' : 'bg-black text-white'} font-black text-xl flex items-center justify-center`}>ES</div>
                            <div className="flex flex-col">
                                <span className="font-extrabold text-lg leading-none">AGENCY</span>
                                <span className={`text-[9px] ${darkMode ? 'text-zinc-400' : 'text-zinc-500'} tracking-widest uppercase`}>Creative Studio</span>
                            </div>
                        </a>
                        <div className="hidden md:flex items-center gap-6 text-xs font-bold">
                            <a href="#services" className="hover:opacity-75">الخدمات</a>
                            <a href="#calculator" className="hover:opacity-75">الحاسبة</a>
                            <a href="#process" className="hover:opacity-75">خطة العمل</a>
                            <a href="#portfolio" className="hover:opacity-75">المعرض</a>
                            <a href="#faq" className="hover:opacity-75">الأسئلة</a>
                        </div>
                        <div className="flex items-center gap-3">
                            {/* Dark Mode Toggle Button */}
                            <button onClick={toggleDarkMode} className={`p-2 rounded-xl border ${borderClass} hover:opacity-80 transition`} title="تبديل المظهر">
                                <i data-lucide={darkMode ? "sun" : "moon"} className="w-4 h-4"></i>
                            </button>
                            <button onClick={openMessenger} className={`${darkMode ? 'bg-white text-black' : 'bg-black text-white'} px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-1.5 hover:opacity-90 transition`}>
                                <i data-lucide="message-square" className="w-4 h-4"></i>
                                تواصل الآن
                            </button>
                        </div>
                    </nav>

                    {/* Hero Section */}
                    <header className="pt-12 pb-12 px-4 max-w-7xl mx-auto text-center">
                        <div className={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border ${borderClass} ${darkMode ? 'bg-zinc-900' : 'bg-zinc-50'} text-xs font-medium mb-8`}>
                            <span className={`w-2 h-2 rounded-full ${darkMode ? 'bg-white' : 'bg-black'} animate-pulse`}></span>
                            وكالة تصميم وإعلانات موجهة للبيع والتفاعل
                        </div>
                        <h1 className="text-3xl sm:text-5xl md:text-6xl font-black leading-tight mb-6 max-w-4xl mx-auto">
                            {AGENCY_CONFIG.headline}
                        </h1>
                        <p className={`${darkMode ? 'text-zinc-400' : 'text-zinc-600'} text-xs sm:text-base max-w-2xl mx-auto leading-relaxed mb-8`}>
                            {AGENCY_CONFIG.subheadline}
                        </p>
                        <div className="flex flex-col sm:flex-row items-center justify-center gap-4">
                            <a href="#calculator" onClick={playClickSound} className={`w-full sm:w-auto ${darkMode ? 'bg-white text-black' : 'bg-black text-white'} px-8 py-3.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 hover:opacity-90 transition`}>
                                <i data-lucide="calculator" className="w-4 h-4"></i>
                                احسب تكلفة مشروعك الآن
                            </a>
                            <button onClick={openMessenger} className={`w-full sm:w-auto border ${borderClass} px-8 py-3.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 hover:bg-zinc-500/10 transition`}>
                                <i data-lucide="message-square" className="w-4 h-4"></i>
                                مراسلة عبر ماسنجر
                            </button>
                        </div>
                    </header>

                    {/* Live Stats Bar (المرحلة الرابعة) */}
                    <section className={`py-10 border-y ${borderClass} ${darkMode ? 'bg-zinc-900/40' : 'bg-zinc-50/80'} px-4 max-w-7xl mx-auto my-8`}>
                        <div className="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                            {STATS.map((st, i) => (
                                <div key={i} className="flex flex-col items-center">
                                    <span className="text-2xl sm:text-4xl font-black mb-1">{st.val}</span>
                                    <span className={`text-[11px] font-semibold ${darkMode ? 'text-zinc-400' : 'text-zinc-600'}`}>{st.label}</span>
                                </div>
                            ))}
                        </div>
                    </section>

                    {/* Interactive Work Process (المرحلة الرابعة) */}
                    <section id="process" className="py-16 px-4 max-w-7xl mx-auto">
                        <div className="text-center max-w-2xl mx-auto mb-12">
                            <span className="text-[10px] font-bold uppercase tracking-widest text-zinc-500 block mb-1">خطوات التنفيذ</span>
                            <h2 className="text-2xl sm:text-3xl font-black">كيف نعمل على مشروعك؟</h2>
                        </div>
                        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                            {PROCESS_STEPS.map((step, idx) => (
                                <div key={idx} className={`${cardClass} p-6 rounded-2xl relative`}>
                                    <span className="text-3xl font-black text-zinc-400/30 absolute top-4 left-4">{step.step}</span>
                                    <h3 className="text-base font-extrabold mb-2">{step.title}</h3>
                                    <p className={`text-xs ${darkMode ? 'text-zinc-400' : 'text-zinc-600'} leading-relaxed`}>{step.desc}</p>
                                </div>
                            ))}
                        </div>
                    </section>

                    {/* Calculator Section */}
                    <section id="calculator" className={`py-16 border-t ${borderClass} px-4 max-w-5xl mx-auto`}>
                        <div className={`${cardClass} rounded-3xl p-6 sm:p-10`}>
                            <div className="text-center mb-8">
                                <h2 className="text-2xl sm:text-3xl font-black">صمم باقتك واحسب سعرها فوراً</h2>
                            </div>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                                <div>
                                    <label className="block text-xs font-bold mb-2">اختر الخدمة:</label>
                                    <select 
                                        value={calcService}
                                        onChange={(e) => { playClickSound(); setCalcService(e.target.value); }}
                                        className={`w-full px-4 py-3 rounded-xl ${darkMode ? 'bg-zinc-800 text-white border-zinc-700' : 'bg-white text-black border-zinc-300'} text-xs font-semibold focus:outline-none`}
                                    >
                                        {SERVICES.map(s => (
                                            <option key={s.id} value={s.id}>{s.title} ({s.price} ج.م / {s.unit})</option>
                                        ))}
                                    </select>
                                </div>
                                <div>
                                    <label className="block text-xs font-bold mb-2">الكمية / عدد الدقائق:</label>
                                    <div className="flex items-center gap-3">
                                        <button onClick={() => { playClickSound(); setCalcQty(Math.max(1, calcQty - 1)); }} className={`w-10 h-10 rounded-xl border ${borderClass} font-bold text-lg`}>-</button>
                                        <span className="text-base font-black px-4">{calcQty}</span>
                                        <button onClick={() => { playClickSound(); setCalcQty(calcQty + 1); }} className={`w-10 h-10 rounded-xl border ${borderClass} font-bold text-lg`}>+</button>
                                    </div>
                                </div>
                            </div>
                            <div className={`flex items-center justify-between p-6 ${darkMode ? 'bg-white text-black' : 'bg-black text-white'} rounded-2xl`}>
                                <div>
                                    <span className="text-[10px] block opacity-80">التكلفة التقديرية:</span>
                                    <span className="text-3xl font-black">{calculatedTotal} <span className="text-xs font-normal">ج.م</span></span>
                                </div>
                                <button onClick={openMessenger} className={`${darkMode ? 'bg-black text-white' : 'bg-white text-black'} px-6 py-3 rounded-xl font-bold text-xs hover:opacity-90 transition`}>
                                    طلب عبر ماسنجر
                                </button>
                            </div>
                        </div>
                    </section>

                    {/* Services Section */}
                    <section id="services" className={`py-16 border-t ${borderClass} px-4 max-w-7xl mx-auto`}>
                        <div className="text-center max-w-2xl mx-auto mb-12">
                            <h2 className="text-2xl sm:text-3xl font-black mb-2">خدماتنا الإبداعية</h2>
                        </div>
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {SERVICES.map((srv) => (
                                <div key={srv.id} className={`${cardClass} rounded-2xl p-6 flex flex-col justify-between`}>
                                    <div>
                                        <span className={`text-[10px] font-bold px-2.5 py-1 rounded ${darkMode ? 'bg-zinc-800 text-zinc-300' : 'bg-zinc-100 text-zinc-800'} mb-3 inline-block`}>{srv.badge}</span>
                                        <h3 className="text-base font-bold mb-2">{srv.title}</h3>
                                        <p className={`text-xs ${darkMode ? 'text-zinc-400' : 'text-zinc-600'} mb-6 leading-relaxed`}>{srv.desc}</p>
                                    </div>
                                    <div className={`pt-4 border-t ${borderClass} flex items-end justify-between`}>
                                        <span className="text-lg font-black">{srv.price} <span className="text-xs font-normal opacity-70">ج.م</span></span>
                                        <span className="text-[11px] opacity-70">{srv.unit}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>

                    {/* Portfolio */}
                    <section id="portfolio" className={`py-16 border-t ${borderClass} px-4 max-w-7xl mx-auto`}>
                        <div className="text-center max-w-2xl mx-auto mb-10">
                            <h2 className="text-2xl sm:text-3xl font-black mb-2">معرض الأعمال</h2>
                        </div>
                        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            {PORTFOLIO_ITEMS.map(item => (
                                <div key={item.id} onClick={() => { playClickSound(); setLightboxImg(item.img); }} className={`relative group cursor-pointer rounded-2xl overflow-hidden aspect-square border ${borderClass}`}>
                                    <img src={item.img} className="w-full h-full object-cover transition duration-500 group-hover:scale-105" />
                                    <div className="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition flex items-center justify-center p-4">
                                        <h3 className="text-white font-bold text-sm text-center">{item.title}</h3>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>

                    {/* High-Converting Call-to-Action Banner (المرحلة الرابعة) */}
                    <section className="py-16 px-4 max-w-7xl mx-auto">
                        <div className={`rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden ${darkMode ? 'bg-white text-black' : 'bg-black text-white'}`}>
                            <h2 className="text-2xl sm:text-4xl font-black mb-4">جاهز لتحويل مشاهدي قناتك وصفحتك إلى عملاء؟</h2>
                            <p className="text-xs sm:text-sm opacity-80 max-w-xl mx-auto mb-8">دعنا نتولى كتابة الفكرة، رسم المشاهد، وتحريك الفيديوهات بأفضل جودة تناسب ميزانيتك.</p>
                            <button onClick={openMessenger} className={`px-8 py-4 rounded-xl font-bold text-xs ${darkMode ? 'bg-black text-white' : 'bg-white text-black'} shadow-xl hover:scale-105 transition`}>
                                أبداء محادثتك فوراً عبر ماسنجر
                            </button>
                        </div>
                    </section>

                    {/* Sticky Quick-Bar Mobile */}
                    <div className={`md:hidden fixed bottom-0 left-0 right-0 ${darkMode ? 'bg-zinc-900/95 border-zinc-800' : 'bg-white/95 border-zinc-200'} border-t p-2.5 z-40 flex items-center justify-around gap-2 shadow-2xl`}>
                        <button onClick={openMessenger} className={`flex-1 ${darkMode ? 'bg-white text-black' : 'bg-black text-white'} py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5`}>
                            <i data-lucide="message-square" className="w-4 h-4"></i>
                            ماسنجر
                        </button>
                        <a href={`https://wa.me/${AGENCY_CONFIG.ownerWhatsApp}`} target="_blank" className={`flex-1 border ${borderClass} py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5`}>
                            <i data-lucide="phone" className="w-4 h-4"></i>
                            واتساب
                        </a>
                    </div>

                    {/* Lightbox Modal */}
                    {lightboxImg && (
                        <div className="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 backdrop-blur-sm" onClick={() => setLightboxImg(null)}>
                            <img src={lightboxImg} className="max-w-full max-h-[85vh] rounded-2xl shadow-2xl" />
                        </div>
                    )}
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<MainApp />);
    </script>
</body>
</html>
// 1. بيانات إشعارات الثقة المباشرة
const RECENT_ACTIVITIES = [
    { id: 1, text: "قام عميل من القاهرة بطلب عرض 8 Reels!", time: "منذ 5 دقائق" },
    { id: 2, text: "تم تسليم مشروع فيديو أنيميشن لمطعم بنجاح ✨", time: "منذ 12 دقيقة" },
    { id: 3, text: "طلب جديد لخدمة تصميم هوية بصرية متكاملة", time: "منذ 25 دقيقة" }
];

// 2. الحالات التفاعلية (أضفها داخل مكون React الرئيسي MainApp)
const [searchTerm, setSearchTerm] = useState('');
const [showConsultModal, setShowConsultModal] = useState(false);
const [currentToast, setCurrentToast] = useState(null);
const [favorites, setFavorites] = useState(() => {
    try {
        return JSON.parse(localStorage.getItem('es_agency_favs')) || [];
    } catch (e) {
        return [];
    }
});

// حفظ المفضلة في localStorage
const toggleFavorite = (serviceId) => {
    playClickSound();
    const updated = favorites.includes(serviceId)
        ? favorites.filter(id => id !== serviceId)
        : [...favorites, serviceId];
    setFavorites(updated);
    localStorage.setItem('es_agency_favs', JSON.stringify(updated));
};

// تشغيل إشعارات الثقة تلقائياً كل 12 ثانية
useEffect(() => {
    const interval = setInterval(() => {
        const randomToast = RECENT_ACTIVITIES[Math.floor(Math.random() * RECENT_ACTIVITIES.length)];
        setCurrentToast(randomToast);
        setTimeout(() => setCurrentToast(null), 4000); // إخفاء الإشعار بعد 4 ثوانٍ
    }, 12000);
    return () => clearInterval(interval);
}, []);
{/* شريط البحث الفوري في الخدمات (توضع قبل قسم الخدمات) */}
<div className="max-w-md mx-auto mb-8 px-4">
    <div className={`relative flex items-center rounded-xl border ${borderClass} ${darkMode ? 'bg-zinc-900' : 'bg-zinc-50'} px-3 py-2`}>
        <i data-lucide="search" className="w-4 h-4 text-zinc-400 ml-2"></i>
        <input 
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="ابحث عن خدمة (مثل: أنيميشن، مونتاج، هوية...)"
            className="w-full bg-transparent text-xs font-semibold focus:outline-none"
        />
        {searchTerm && (
            <button onClick={() => setSearchTerm('')} className="text-xs text-zinc-400 hover:text-black">✕</button>
        )}
    </div>
</div>


{/* زر المفضلة التفاعلي (يتم تضمينه داخل بطاقة كل خدمة Services Card) */}
<button 
    onClick={() => toggleFavorite(srv.id)} 
    className={`p-2 rounded-lg transition ${favorites.includes(srv.id) ? 'text-red-500 bg-red-500/10' : 'text-zinc-400 hover:text-black'}`}
    title="حفظ في المفضلة"
>
    <i data-lucide="heart" className={`w-4 h-4 ${favorites.includes(srv.id) ? 'fill-current' : ''}`}></i>
</button>


{/* إشعارات الثقة المباشرة المنبثقة (Live Social Proof Toast) */}
{currentToast && (
    <div className={`fixed bottom-20 right-4 z-50 p-4 rounded-2xl border ${borderClass} ${darkMode ? 'bg-zinc-900 text-white' : 'bg-white text-black'} shadow-2xl flex items-center gap-3 animate-fade-in-up max-w-sm`}>
        <div className="w-8 h-8 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">✓</div>
        <div>
            <p className="text-xs font-bold leading-snug">{currentToast.text}</p>
            <span className="text-[10px] text-zinc-400">{currentToast.time}</span>
        </div>
    </div>
)}


{/* نافذة حجز استشارة سريعة (Quick Consultation Modal) */}
{showConsultModal && (
    <div className="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 backdrop-blur-sm" onClick={() => setShowConsultModal(false)}>
        <div className={`${darkMode ? 'bg-zinc-900 text-white border-zinc-800' : 'bg-white text-black border-zinc-200'} border rounded-3xl p-6 sm:p-8 max-w-lg w-full`} onClick={e => e.stopPropagation()}>
            <div className="flex justify-between items-center mb-6">
                <h3 className="text-lg font-black">احجز استشارة تسويقية مجانية</h3>
                <button onClick={() => setShowConsultModal(false)} className="text-zinc-400 hover:text-black">✕</button>
            </div>
            <p className="text-xs text-zinc-500 mb-6">تحدث مباشرة مع إسلام عمرو لتحديد الباقة المناسبة لمشروعك بأعلى عائد استثماري.</p>
            <button 
                onClick={() => {
                    window.open(`https://wa.me/${AGENCY_CONFIG.ownerWhatsApp}?text=${encodeURIComponent("مرحباً، أريد حجز استشارة مجانية لمشروعي")}`, '_blank');
                    setShowConsultModal(false);
                }}
                className={`w-full py-3.5 rounded-xl text-xs font-bold ${darkMode ? 'bg-white text-black' : 'bg-black text-white'} flex items-center justify-center gap-2`}
            >
                <i data-lucide="phone-call" className="w-4 h-4"></i>
                بدء المحادثة الفورية عبر واتساب
            </button>
        </div>
    </div>
)}
