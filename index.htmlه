<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ES Agency | وكالة صناعة المحتوى البصري والأنيميشن الاحترافي</title>
    
    <meta name="description" content="وكالة ES Agency متخصصة في تصميم الفيديوهات الإعلانية، تحريك الأنيميشن، الموشن جرافيك، المونتاج، والهويات البصرية.">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { black: '#000000', dark: '#09090b', cardDark: '#121215', borderDark: '#27272a' }
                    },
                    fontFamily: { sans: ['Cairo', 'sans-serif'] }
                }
            }
        }
    </script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Cairo', sans-serif; overflow-x: hidden; transition: background-color 0.3s ease, color 0.3s ease; }
        .bw-glass-light { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(0,0,0,0.08); }
        .bw-glass-dark { background: rgba(9, 9, 11, 0.92); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,0.08); }
        .bw-card-light { background: #ffffff; border: 1px solid #e4e4e7; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
        .bw-card-light:hover { border-color: #000000; transform: translateY(-3px); box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.08); }
        .bw-card-dark { background: #121215; border: 1px solid #27272a; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
        .bw-card-dark:hover { border-color: #ffffff; transform: translateY(-3px); box-shadow: 0 12px 24px -8px rgba(255, 255, 255, 0.05); }
        .loader-bg { background: #000; position: fixed; inset: 0; z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        ::-webkit-scrollbar { width: 7px; }
        ::-webkit-scrollbar-thumb { background: #71717a; border-radius: 4px; }
    </style>
</head>
<body class="bg-white text-zinc-900 selection:bg-black selection:text-white">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        const AGENCY_CONFIG = {
