                                        onChange={(e)=>setContactForm({...contactForm, name: e.target.value})}
                                        placeholder="أدخل اسمك"
                                        className="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-black focus:outline-none focus:border-black transition"
                                    />
                                </div>
                                <div>
                                    <label className="block text-[11px] font-bold text-zinc-700 mb-1">رقم الهاتف *</label>
                                    <input 
                                        type="tel" 
                                        required
                                        value={contactForm.phone}
                                        onChange={(e)=>setContactForm({...contactForm, phone: e.target.value})}
                                        placeholder="010XXXXXXXX"
                                        className="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-black focus:outline-none focus:border-black transition text-right"
                                    />
                                </div>
                            </div>

                            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label className="block text-[11px] font-bold text-zinc-700 mb-1">نوع الخدمة أو العرض المطلوب</label>
                                    <select 
                                        value={contactForm.service}
                                        onChange={(e)=>setContactForm({...contactForm, service: e.target.value})}
                                        className="w-full px-3 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-black focus:outline-none focus:border-black transition"
                                    >
                                        <option value="العرض الأول 9000 ج.م">العرض الأول (12 ريلز + 60 بوست) - 9000 ج.م</option>
                                        <option value="العرض الثاني 5000 ج.م">العرض الثاني (8 ريلز + 30 بوست) - 5000 ج.م</option>
                                        <option value="العرض الثالث 2500 ج.م">العرض الثالث (4 ريلز + 16 بوست) - 2500 ج.م</option>
                                        <option value="عرض البوستات 1000 ج.م">عرض البوستات (30 بوست) - 1000 ج.م</option>
                                        <option value="عرض الريلز 3000 ج.م">عرض الريلز (8 ريلز) - 3000 ج.م</option>
                                        <option value="تصميم خدمة فردية">طلب خدمة فردية مخصصة</option>
                                    </select>
                                </div>
                                <div>
                                    <label className="block text-[11px] font-bold text-zinc-700 mb-1">الميزانية المتوقعة</label>
                                    <select 
                                        value={contactForm.budget}
                                        onChange={(e)=>setContactForm({...contactForm, budget: e.target.value})}
                                        className="w-full px-3 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-black focus:outline-none focus:border-black transition"
                                    >
                                        <option value="1000 - 2500 ج.م">1000 - 2500 ج.م</option>
                                        <option value="2500 - 5000 ج.م">2500 - 5000 ج.م</option>
                                        <option value="5000 - 9000 ج.م">5000 - 9000 ج.م</option>
                                        <option value="أكثر من 9000 ج.م">أكثر من 9000 ج.م</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label className="block text-[11px] font-bold text-zinc-700 mb-1">تفاصيل الفكرة أو مشروعك</label>
                                <textarea 
                                    rows="3"
                                    value={contactForm.details}
                                    onChange={(e)=>setContactForm({...contactForm, details: e.target.value})}
                                    placeholder="اكتب وصفاً مختصراً عن المنتج أو الخدمة التي تريد الإعلان عنها..."
                                    className="w-full px-3.5 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-black focus:outline-none focus:border-black transition resize-none"
                                ></textarea>
                            </div>

                            <button 
                                type="submit" 
                                className="w-full py-3 rounded-xl bw-btn-primary font-bold text-xs flex items-center justify-center gap-2"
                            >
                                <i data-lucide="send" className="w-3.5 h-3.5"></i>
                                إرسال الطلب لإدارة الوكالة
                            </button>
                        </form>
                    </section>

                    {/* Footer */}
                    <footer className="border-t border-zinc-200 bg-zinc-50 py-10 px-4">
                        <div className="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                            <div>
                                <div className="flex items-center gap-2 mb-3">
                                    <div className="w-7 h-7 rounded bg-black text-white font-black flex items-center justify-center text-sm">ES</div>
                                    <span className="font-extrabold tracking-wider text-black text-sm">AGENCY</span>
                                </div>
                                <p className="text-zinc-600 text-[11px] leading-relaxed">وكالة صناعة المحتوى البصري، تحريك الأنيميشن، والتصاميم الموجهة لرفع نسبة المبيعات والتفاعل.</p>
                            </div>

                            <div>
                                <h4 className="font-bold text-xs text-black uppercase tracking-wider mb-3">روابط سريعة</h4>
                                <ul className="space-y-1.5 text-[11px] text-zinc-600">
                                    <li><a href="#services" onClick={()=>playClickSound()} className="hover:text-black transition">الخدمات الإعلانية</a></li>
                                    <li><a href="#packs" onClick={()=>playClickSound()} className="hover:text-black transition">جدول العروض والأسعار</a></li>
                                    <li><a href="#portfolio" onClick={()=>playClickSound()} className="hover:text-black transition">معرض الأعمال</a></li>
                                    <li><a href="#policies" onClick={()=>playClickSound()} className="hover:text-black transition">شروط وضوابط العمل</a></li>
                                </ul>
                            </div>

                            <div>
                                <h4 className="font-bold text-xs text-black uppercase tracking-wider mb-3">التواصل المباشر</h4>
                                <ul className="space-y-1.5 text-[11px] text-zinc-600">
                                    <li>مراسلة ماسنجر المباشرة</li>
                                    <li>اتصل بنا أو اترك رقمك بالنموذج</li>
                                    <li>ساعات العمل: 10:00 ص - 10:00 م</li>
                                </ul>
                            </div>

                            <div>
                                <h4 className="font-bold text-xs text-black uppercase tracking-wider mb-3">منصات التواصل الاجتماعي</h4>
                                <div className="flex items-center gap-2">
                                    <a href={AGENCY_CONFIG.social.facebook} target="_blank" onClick={()=>playClickSound()} className="p-2 rounded-xl bg-white border border-zinc-200 text-zinc-700 hover:text-black hover:border-black transition">
                                        <i data-lucide="facebook" className="w-4 h-4"></i>
                                    </a>
                                    <a href={AGENCY_CONFIG.social.instagram} target="_blank" onClick={()=>playClickSound()} className="p-2 rounded-xl bg-white border border-zinc-200 text-zinc-700 hover:text-black hover:border-black transition">
                                        <i data-lucide="instagram" className="w-4 h-4"></i>
                                    </a>
                                    <a href={AGENCY_CONFIG.social.tiktok} target="_blank" onClick={()=>playClickSound()} className="p-2 rounded-xl bg-white border border-zinc-200 text-zinc-700 hover:text-black hover:border-black transition">
                                        <i data-lucide="video" className="w-4 h-4"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div className="max-w-6xl mx-auto pt-6 border-t border-zinc-200 flex items-center justify-between text-[10px] text-zinc-500">
                            <p>© {new Date().getFullYear()} {AGENCY_CONFIG.name}. جميع الحقوق محفوظة.</p>
                            <button 
                                onClick={() => triggerAction(() => setIsAdminOpen(true))}
                                className="opacity-30 hover:opacity-100 transition p-1"
                                title="لوحة التحكم والرمز السري"
                            >
                                <i data-lucide="lock" className="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </footer>

                    {/* Floating Messenger Button */}
                    <button 
                        onClick={() => triggerAction(openMessenger)}
                        className="fixed bottom-5 left-5 z-40 w-12 h-12 rounded-full bg-black text-white flex items-center justify-center shadow-xl hover:scale-110 transition border border-zinc-800"
                        title="تواصل معنا عبر ماسنجر"
                    >
                        <i data-lucide="message-square" className="w-6 h-6"></i>
                    </button>

                    {/* Modals & Dialogs */}
                    {showSuccessModal && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
                            <div className="bw-card rounded-2xl p-6 max-w-sm w-full text-center border border-zinc-200">
                                <div className="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center mx-auto mb-3">
                                    <i data-lucide="check" className="w-5 h-5"></i>
                                </div>
                                <h3 className="text-base font-bold text-black mb-1">تم تجهيز بيانات طلبك!</h3>
                                <p className="text-zinc-600 text-xs mb-5">
                                    شكراً لك يا <strong>{contactForm.name}</strong>. تم تحويل بياناتك لتواصل الوكالة المباشر.
                                </p>
                                <button 
                                    onClick={() => triggerAction(() => setShowSuccessModal(false))}
                                    className="w-full py-2.5 rounded-xl bw-btn-primary font-bold text-xs"
                                >
                                    حسناً
                                </button>
                            </div>
                        </div>
                    )}

                    {/* Admin & Passcode Unlock Modal */}
                    {isAdminOpen && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
                            <div className="bw-card rounded-2xl p-6 max-w-xl w-full relative border border-zinc-200 max-h-[85vh] overflow-y-auto">
                                <button 
                                    onClick={() => triggerAction(() => { setIsAdminOpen(false); resetPortfolioForm(); })}
                                    className="absolute top-4 left-4 text-zinc-400 hover:text-black p-1"
                                >
                                    <i data-lucide="x" className="w-4 h-4"></i>
                                </button>

                                {!isAuthenticated ? (
                                    <form onSubmit={handleAdminLogin} className="space-y-4 pt-2 text-center max-w-xs mx-auto">
                                        <i data-lucide="lock" className="w-7 h-7 text-black mx-auto mb-1"></i>
                                        <h3 className="text-base font-bold text-black">إدخال الرمز السري</h3>
                                        <p className="text-[11px] text-zinc-500">أدخل الرمز السري لتمكين خيار إضافة التصاميم المربعة في الواجهة</p>

                                        <input 
                                            type="password"
                                            value={passcode}
                                            onChange={(e) => setPasscode(e.target.value)}
                                            placeholder="الرمز السري (12345)"
                                            className="w-full px-3 py-2.5 rounded-xl bg-zinc-50 border border-zinc-300 text-black text-center text-xs focus:outline-none focus:border-black"
                                        />

                                        <button type="submit" className="w-full py-2.5 rounded-xl bw-btn-primary font-bold text-xs">
                                            تأكيد الدخول
                                        </button>
                                    </form>
                                ) : (
                                    <div>
                                        <div className="flex border-b border-zinc-200 mb-5 gap-4">
                                            <button 
                                                onClick={() => triggerAction(() => { resetPortfolioForm(); setAdminTab("manage_portfolio"); })}
                                                className={`text-xs font-bold pb-2 ${adminTab === "manage_portfolio" ? "text-black border-b-2 border-black" : "text-zinc-500"}`}
                                            >
                                                إدارة وحذف التصاميم ({portfolio.length})
                                            </button>
                                            <button 
                                                onClick={() => triggerAction(() => setAdminTab("add_portfolio"))}
                                                className={`text-xs font-bold pb-2 ${adminTab === "add_portfolio" ? "text-black border-b-2 border-black" : "text-zinc-500"}`}
                                            >
                                                {editingPortfolioId ? "تعديل التصميم" : "+ إضافة تصميم مربع جديد"}
                                            </button>
                                        </div>

                                        {adminTab === "manage_portfolio" && (
                                            <div className="space-y-2.5">
                                                {portfolio.map((item) => (
                                                    <div key={item.id} className="flex items-center justify-between p-2.5 rounded-xl bg-zinc-50 border border-zinc-200">
                                                        <div className="flex items-center gap-2.5">
                                                            <img src={item.image} alt={item.title} className="w-10 h-10 rounded-lg object-cover border border-zinc-200" />
                                                            <div>
                                                                <h5 className="text-xs font-bold text-black">{item.title}</h5>
                                                                <span className="text-[9px] text-zinc-500">{item.category}</span>
                                                            </div>
                                                        </div>
                                                        <div className="flex items-center gap-1.5">
                                                            <button 
                                                                onClick={() => handleEditPortfolioClick(item)}
                                                                className="px-2.5 py-1 rounded-lg bg-black text-white text-[10px] font-bold"
                                                            >
                                                                تعديل
                                                            </button>
                                                            <button 
                                                                onClick={() => handleDeletePortfolio(item.id)}
                                                                className="px-2.5 py-1 rounded-lg bg-red-600 text-white text-[10px] font-bold"
                                                            >
                                                                حذف
                                                            </button>
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        )}

                                        {adminTab === "add_portfolio" && (
                                            <form onSubmit={handleAddOrUpdatePortfolio} className="space-y-3">
                                                <div>
                                                    <label className="block text-[11px] font-bold text-zinc-700 mb-1">عنوان التصميم المربع *</label>
                                                    <input 
                                                        type="text" 
                                                        placeholder="مثال: تصميم مربع بنمط الكرسي"
                                                        value={newItemTitle}
                                                        onChange={(e)=>setNewItemTitle(e.target.value)}
                                                        className="w-full p-2.5 rounded-xl bg-zinc-50 border border-zinc-300 text-xs text-black focus:outline-none focus:border-black"
                                                    />
                                                </div>

                                                <div>
                                                    <label className="block text-[11px] font-bold text-zinc-700 mb-1">رفع صورة التصميم (Square Image) *</label>
                                                    <input 
                                                        type="file" 
                                                        accept="image/*"
                                                        onChange={handleImageFileChange}
                                                        className="w-full p-2 rounded-xl bg-zinc-50 border border-zinc-300 text-xs text-zinc-700 file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[10px] file:bg-black file:text-white"
                                                    />
                                                    {newItemImg && (
                                                        <div className="mt-2 flex items-center gap-2">
                                                            <img src={newItemImg} alt="Preview" className="w-12 h-12 rounded-lg object-cover border border-zinc-300" />
                                                            <span className="text-[10px] text-green-600 font-bold">تم جاهزية الصورة للرفع</span>
                                                        </div>
                                                    )}
                                                </div>

                                                <div className="grid grid-cols-2 gap-3">
                                                    <div>
                                                        <label className="block text-[11px] font-bold text-zinc-700 mb-1">القسم</label>
                                                        <select 
                                                            value={newItemCategory}
                                                            onChange={(e)=>setNewItemCategory(e.target.value)}
                                                            className="w-full p-2.5 rounded-xl bg-zinc-50 border border-zinc-300 text-xs text-black"
                                                        >
                                                            <option value="Video">Video</option>
                                                            <option value="Ads">Ads</option>
                                                            <option value="Social Media">Social Media</option>
                                                            <option value="Motion Graphics">Motion Graphics</option>
                                                            <option value="Branding">Branding</option>
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label className="block text-[11px] font-bold text-zinc-700 mb-1">الشكل والنمط</label>
                                                        <select 
                                                            value={newItemRatio}
                                                            onChange={(e)=>setNewItemRatio(e.target.value)}
                                                            className="w-full p-2.5 rounded-xl bg-zinc-50 border border-zinc-300 text-xs text-black"
                                                        >
                                                            <option value="aspect-square">مربع الشكل (1:1)</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <button type="submit" className="w-full py-2.5 rounded-xl bw-btn-primary font-bold text-xs mt-2">
                                                    {editingPortfolioId ? "حفظ التعديلات" : "حفظ ونشر في المعرض الذكي"}
                                                </button>
                                            </form>
                                        )}
                                    </div>
                                )}
                            </div>
                        </div>
                    )}

                    {/* Selected Service Modal */}
                    {selectedService && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
                            <div className="bw-card rounded-2xl p-6 max-w-md w-full relative border border-zinc-200">
                                <button 
                                    onClick={() => triggerAction(() => setSelectedService(null))}
                                    className="absolute top-4 left-4 text-zinc-400 hover:text-black p-1"
                                >
                                    <i data-lucide="x" className="w-4 h-4"></i>
                                </button>
                                <h3 className="text-base font-extrabold text-black mb-2">{selectedService.title}</h3>
                                <p className="text-zinc-600 text-xs mb-4">{selectedService.description}</p>
                                <div className="p-3 rounded-xl bg-zinc-50 border border-zinc-200 flex justify-between items-center mb-4">
                                    <span className="text-base font-black text-black">{selectedService.price} ج.م</span>
                                    <span className="text-[11px] text-zinc-500 font-medium">{selectedService.delivery}</span>
                                </div>
                                <button 
                                    onClick={() => triggerAction(() => { setSelectedService(null); openMessenger(); })}
                                    className="w-full py-2.5 rounded-xl bw-btn-primary font-bold text-xs flex items-center justify-center gap-2"
                                >
                                    <i data-lucide="message-square" className="w-3.5 h-3.5"></i>
                                    طلب الخدمة عبر ماسنجر
                                </button>
                            </div>
                        </div>
                    )}

                    {/* Selected Portfolio Item Modal */}
                    {selectedPortfolio && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
                            <div className="bw-card rounded-2xl p-5 max-w-md w-full relative border border-zinc-200">
                                <button 
                                    onClick={() => triggerAction(() => setSelectedPortfolio(null))}
                                    className="absolute top-4 left-4 text-zinc-400 hover:text-black p-1 z-10"
                                >
                                    <i data-lucide="x" className="w-4 h-4"></i>
                                </button>

                                <div className="w-full aspect-square rounded-xl overflow-hidden bg-zinc-100 mb-3 border border-zinc-200">
                                    <img src={selectedPortfolio.image} alt={selectedPortfolio.title} className="w-full h-full object-cover" />
                                </div>

                                <h3 className="text-sm font-bold text-black mb-1">{selectedPortfolio.title}</h3>
                                <p className="text-zinc-600 text-xs mb-3">{selectedPortfolio.desc}</p>

                                <button 
                                    onClick={() => triggerAction(() => { setSelectedPortfolio(null); openMessenger(); })}
                                    className="w-full py-2.5 rounded-xl bw-btn-primary font-bold text-xs flex items-center justify-center gap-2"
                                >
                                    <i data-lucide="message-square" className="w-3.5 h-3.5"></i>
                                    طلب تصميم مماثل عبر ماسنجر
                                </button>
                            </div>
                        </div>
                    )}

                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<MainApp />);
    </script>
</body>
      </html>
