            ownerWhatsApp: "201020185275",
            social: {
                messenger: "https://www.facebook.com/share/1BbzgSxQYE/",
                instagram: "https://www.instagram.com/eslam_amr_almasry?igsh=MTVia3Y5NmY3d2h0Mw=="
            }
        };

        const STATS = [
            { label: "مشروع مكتمل بنجاح", val: "+180", icon: "check-circle" },
