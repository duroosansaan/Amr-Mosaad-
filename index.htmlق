<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ES Marketing Agency | وكالة إي إس للتسويق الإلكتروني</title>
    <!-- Google Fonts - Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS Link -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- Header & Navigation -->
    <header class="site-header">
        <div class="container nav-container">
            <div class="logo-box">
                <span class="logo-e">E</span><span class="logo-s">S</span>
                <span class="logo-text">Marketing Agency</span>
            </div>
            <nav class="main-nav">
                <a href="#hero">الرئيسية</a>
                <a href="#targets">أعمالنا والتخصصات</a>
                <a href="#packages">الباقات والأسعار</a>
                <a href="#addons">الإضافات والخدمات</a>
                <a href="#contact" class="nav-btn">تواصل معنا</a>
            </nav>
            <div class="menu-toggle" id="menuToggle">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="hero-section">
        <div class="container hero-content">
            <div class="hero-text-box">
                <span class="badge-tag">الاحترافية والإبداع في مكان واحد</span>
                <h1>اصنع علامتك التجارية مع <span>ES Agency</span></h1>
                <p>نقدم حلول تسويقية متكاملة، تصميمات بصرية مربعة مذهلة، فيديوهات ريلز تخطف الأنظار، ومواقع إلكترونية تفاعلية ترفع مبيعاتك لأعلى المستويات.</p>
                <div class="hero-btns">
                    <a href="#packages" class="btn btn-primary">استعرض الباقات والأسعار</a>
                    <a href="#targets" class="btn btn-outline">شاهد أعمال التخصصات</a>
                </div>
            </div>
            <div class="hero-visual-box">
                <!-- شكل تفاعلي يعكس هوية اللوجو بالأحمر والذهبي -->
                <div class="hero-logo-card">
                    <div class="es-glow"></div>
                    <div class="big-es-logo">
                        <span class="e-red">E</span><span class="s-gold">S</span>
                    </div>
                    <p>Marketing & Creative Agency</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Targets & Categories Section (معرض التخصصات والمربعات) -->
    <section id="targets" class="targets-section">
        <div class="container">
            <div class="section-title">
                <h2>معرض أعمالنا حسب التخصصات</h2>
                <p>تصاميم مربعة ومبتكرة مصممة خصيصاً لكل قطاع لضمان أعلى تفاعل</p>
            </div>

            <!-- Filter Buttons -->
            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all">الكل</button>
                <button class="filter-btn" data-filter="restaurants">المطاعم والكافيهات</button>
                <button class="filter-btn" data-filter="cars">استوديوهات السيارات</button>
                <button class="filter-btn" data-filter="hotels">الفنادق والشركات</button>
                <button class="filter-btn" data-filter="lawyers">المحامين</button>
                <button class="filter-btn" data-filter="teachers">المعلمين</button>
                <button class="filter-btn" data-filter="doctors">عيادات الأطباء</button>
                <button class="filter-btn" data-filter="brands">براندات الملابس</button>
            </div>

            <!-- Grid Cards -->
            <div class="targets-grid" id="targetsGrid">
                <!-- Restaurants -->
                <div class="target-card" data-category="restaurants">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-utensils"></i>
                        <span>مطاعم وكافيهات (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>اللاذع وبروست زون</h3>
                        <p>تصاميم ترويجية تنبض بالحياة وتجذب عشاق الوجبات السريعة.</p>
                    </div>
                </div>

                <!-- Cars -->
                <div class="target-card" data-category="cars">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-car-side"></i>
                        <span>استوديوهات السيارات (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>عروض أودي وبي إم دبليو</h3>
                        <p>إبراز فخامة السيارات وعروض التقسيط بمقدمات تنافسية.</p>
                    </div>
                </div>

                <!-- Hotels -->
                <div class="target-card" data-category="hotels">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-hotel"></i>
                        <span>الفنادق والسياحة (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>فنادق الإسكندرية والعين السخنة</h3>
                        <p>حملات إعلانية ترويجية لموسم المصايف والرحلات السياحية.</p>
                    </div>
                </div>

                <!-- Lawyers -->
                <div class="target-card" data-category="lawyers">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-scale-balanced"></i>
                        <span>المحامين والقانون (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>تأسيس الشركات والشهر العقاري</h3>
                        <p>تصاميم رسمية واحترافية تعكس الثقة وموثوقية الخدمات القانونية.</p>
                    </div>
                </div>

                <!-- Teachers -->
                <div class="target-card" data-category="teachers">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>المعلمين والتعليم (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>إعداد المحتوى التعليمي</h3>
                        <p>تصاميم مبسطة وجذابة لتبسيط المناهج وشرح المراجعات للطلاب.</p>
                    </div>
                </div>

                <!-- Doctors -->
                <div class="target-card" data-category="doctors">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-user-doctor"></i>
                        <span>عيادات الأطباء (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>الرعاية الصحية وأمان العيادة</h3>
                        <p>تصاميم توعوية وعلاجية تركز على صحة وراحة المرضى.</p>
                    </div>
                </div>

                <!-- Brands -->
                <div class="target-card" data-category="brands">
                    <div class="card-img-placeholder">
                        <i class="fa-solid fa-shirt"></i>
                        <span>براندات الملابس - باندا (تصميم مربع)</span>
                    </div>
                    <div class="card-info">
                        <h3>تيشرتات باندا والخصومات</h3>
                        <p>عروض الموضة والملابس بتصميمات عصرية تخطف الأنفاس.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Packages Section (الباقات والأسعار) -->
    <section id="packages" class="packages-section">
        <div class="container">
            <div class="section-title">
                <h2>باقات الأسعار والخدمات الفردية</h2>
                <p>اختر الباقة المناسبة لطموحات مشروعك التجاري</p>
            </div>

            <div class="packages-grid">
                <!-- Enterprise -->
                <div class="package-card featured">
                    <div class="ribbon">الأكثر توفيراً</div>
                    <h3>الباقة الكبرى (Enterprise)</h3>
                    <div class="price">9,000 <span>جنيه</span></div>
                    <ul>
                        <li><i class="fa-solid fa-check"></i> 12 فيديو ريلز احترافي</li>
                        <li><i class="fa-solid fa-check"></i> 60 تصميم مربع (60 Design)</li>
                        <li><i class="fa-solid fa-check"></i> إدارة كاملة لحملات السوشيال ميديا</li>
                    </ul>
                    <a href="#contact" class="btn btn-primary">اطلب الباقة</a>
                </div>

                <!-- Pro -->
                <div class="package-card">
                    <h3>باقة الاحتراف (Pro)</h3>
                    <div class="price">5,000 <span>جنيه</span></div>
                    <ul>
                        <li><i class="fa-solid fa-check"></i> 8 فيديوهات ريلز</li>
                        <li><i class="fa-solid fa-check"></i> 30 تصميم بوست مربع</li>
                        <li><i class="fa-solid fa-check"></i> استراتيجية تسويقية متكاملة</li>
                    </ul>
                    <a href="#contact" class="btn btn-outline">اطلب الباقة</a>
                </div>

                <!-- Standard -->
                <div class="package-card">
                    <h3>الباقة المتوسطة (Standard)</h3>
                    <div class="price">2,500 <span>جنيه</span></div>
                    <ul>
                        <li><i class="fa-solid fa-check"></i> 4 فيديوهات ريلز</li>
                        <li><i class="fa-solid fa-check"></i> 16 تصميم بوست مربع</li>
                        <li><i class="fa-solid fa-check"></i> تقارير أداء شهرية</li>
                    </ul>
                    <a href="#contact" class="btn btn-outline">اطلب الباقة</a>
                </div>

                <!-- Design Only -->
                <div class="package-card">
                    <h3>باقة التصاميم فقط</h3>
                    <div class="price">1,000 <span>جنيه</span></div>
                    <ul>
                        <li><i class="fa-solid fa-check"></i> 30 تصميم بوست مربع</li>
                        <li><i class="fa-solid fa-check"></i> تعديلات غير محدودة</li>
                    </ul>
                    <a href="#contact" class="btn btn-outline">اطلب الباقة</a>
                </div>

                <!-- Videos Only -->
                <div class="package-card">
                    <h3>باقة الفيديوهات فقط</h3>
                    <div class="price">3,000 <span>جنيه</span></div>
                    <ul>
                        <li><i class="fa-solid fa-check"></i> 8 فيديوهات ريلز احترافية</li>
                        <li><i class="fa-solid fa-check"></i> مونتاج ومؤثرات بصرية</li>
                    </ul>
                    <a href="#contact" class="btn btn-outline">اطلب الباقة</a>
                </div>
            </div>

            <!-- Single Services Pricing Box -->
            <div class="single-services-box">
                <h3>أسعار الخدمات الفردية</h3>
                <div class="single-list">
                    <div class="single-item"><span>تصميم بوست واحد:</span> <strong>180 جنيه</strong></div>
                    <div class="single-item"><span>فيديوهات والريلز (خفيف إلى احترافي):</span> <strong>300 - 680 جنيه</strong></div>
                    <div class="single-item"><span>بناء موقع إلكتروني متكامل:</span> <strong>1,600 - 10,000 جنيه</strong></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Add-ons Section (الإضافات المدفوعة) -->
    <section id="addons" class="addons-section">
        <div class="container">
            <div class="section-title">
                <h2>الخدمات الإضافية المتقدمة</h2>
                <p>عزز كفاءة موقعك وعملك بإضافات ذكية ومخصصة</p>
            </div>
            <div class="addons-grid">
                <div class="addon-card">
                    <div class="addon-icon"><i class="fa-solid fa-robot"></i></div>
                    <h3>Chatbot Integration</h3>
                    <p>دمج مساعد ذكي داخل موقعك للرد على استفسارات العملاء على مدار الساعة.</p>
                    <div class="addon-price">2,000 جنيه</div>
                </div>
                <div class="addon-card">
                    <div class="addon-icon"><i class="fa-solid fa-calendar-days"></i></div>
                    <h3>Work Calendar System</h3>
                    <p>نظام جدولة مهام ومواعيد متقدم لإدارة أعمالك وحجوزات العملاء بدقة.</p>
                    <div class="addon-price">500 جنيه</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
        <div class="container contact-container">
            <div class="contact-info">
                <h2>ابدأ مشروعك معنا الآن</h2>
                <p>تواصل مع فريق **ES Marketing Agency** ودعنا نحول أفكارك إلى واقع رقمي مبهر يحقق أرباحاً حقيقية.</p>
                <div class="info-item"><i class="fa-solid fa-location-dot"></i><span>مصر - El Obour City</span></div>
                <div class="info-item"><i class="fa-solid fa-envelope"></i><span>es.agency@marketing.com</span></div>
            </div>
            <div class="contact-form-box">
                <form id="agencyForm">
                    <div class="form-group">
                        <input type="text" placeholder="اسمك الكريم" required>
                    </div>
                    <div class="form-group">
                        <input type="text" placeholder="رقم الهاتف أو البريد الإلكتروني" required>
                    </div>
                    <div class="form-group">
                        <select>
                            <option value="enterprise">الباقة الكبرى (9,000 ج)</option>
                            <option value="pro">باقة الاحتراف (5,000 ج)</option>
                            <option value="standard">الباقة المتوسطة (2,500 ج)</option>
                            <option value="designs">باقة التصاميم فقط (1,000 ج)</option>
                            <option value="videos">باقة الفيديوهات فقط (3,000 ج)</option>
                            <option value="website">بناء موقع إلكتروني</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <textarea placeholder="تفاصيل مشروعك أو طلبك الإضافي..." rows="4"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary full-width">إرسال الطلب</button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container footer-content">
            <p>جميع الحقوق محفوظة &copy; 2026 <strong>ES Marketing Agency</strong></p>
            <div class="social-links">
                <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#"><i class="fa-brands fa-instagram"></i></a>
                <a href="#"><i class="fa-brands fa-behance"></i></a>
                <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
            </div>
        </div>
    </footer>

    <!-- Custom JS Link -->
    <script src="script.js"></script>
</body>
</html>
/* ================================================= */
/* 1. Global Reset & Variables                        */
/* ================================================= */
:root {
    --bg-dark: #0b0f19;
    --card-bg: #131b2e;
    --card-hover: #1b2642;
    --primary-red: #d92525;
    --primary-gold: #f39c12;
    --text-main: #ffffff;
    --text-muted: #94a3b8;
    --border-color: rgba(255, 255, 255, 0.08);
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Cairo', sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
    overflow-x: hidden;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ================================================= */
/* 2. Header & Navigation                             */
/* ================================================= */
.site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(11, 15, 25, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    z-index: 1000;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
}

.logo-box {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 900;
    font-size: 24px;
    cursor: pointer;
}

.logo-e {
    color: var(--primary-red);
}

.logo-s {
    color: var(--primary-gold);
}

.logo-text {
    font-size: 16px;
    margin-right: 10px;
    letter-spacing: 1px;
    color: var(--text-muted);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 30px;
}

.main-nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    transition: var(--transition);
}

.main-nav a:hover, .main-nav a.active {
    color: var(--text-main);
}

.nav-btn {
    background: linear-gradient(135deg, var(--primary-red), var(--primary-gold));
    color: white !important;
    padding: 8px 20px;
    border-radius: 50px;
    box-shadow: 0 4px 15px rgba(217, 37, 37, 0.3);
}

.menu-toggle {
    display: none;
    font-size: 24px;
    cursor: pointer;
    color: var(--text-main);
}

/* ================================================= */
/* 3. Hero Section                                   */
/* ================================================= */
.hero-section {
    padding: 160px 0 100px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
}

.hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
}

.badge-tag {
    display: inline-block;
    background: rgba(243, 156, 18, 0.1);
    color: var(--primary-gold);
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 20px;
    border: 1px solid rgba(243, 156, 18, 0.2);
}

.hero-text-box h1 {
    font-size: 48px;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero-text-box h1 span {
    background: linear-gradient(135deg, var(--primary-red), var(--primary-gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-text-box p {
    color: var(--text-muted);
    font-size: 18px;
    margin-bottom: 30px;
}

.hero-btns {
    display: flex;
    gap: 15px;
}

.btn {
    padding: 12px 28px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-red), #b51a1a);
    color: white;
    box-shadow: 0 4px 20px rgba(217, 37, 37, 0.4);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 25px rgba(217, 37, 37, 0.6);
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--border-color);
    color: var(--text-main);
}

.btn-outline:hover {
    border-color: var(--primary-gold);
    color: var(--primary-gold);
    transform: translateY(-3px);
}

.hero-visual-box {
    display: flex;
    justify-content: center;
    align-items: center;
}

.hero-logo-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 60px;
    border-radius: 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    width: 100%;
    max-width: 400px;
    transition: var(--transition);
}

.hero-logo-card:hover {
    transform: scale(1.03);
    border-color: rgba(243, 156, 18, 0.3);
}

.es-glow {
    position: absolute;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(217,37,37,0.2) 0%, transparent 70%);
    top: -50px;
    right: -50px;
    z-index: 1;
}

.big-es-logo {
    font-size: 80px;
    font-weight: 900;
    margin-bottom: 10px;
    position: relative;
    z-index: 2;
}

.e-red { color: var(--primary-red); }
.s-gold { color: var(--primary-gold); }

.hero-logo-card p {
    color: var(--text-muted);
    font-size: 14px;
    letter-spacing: 2px;
}

/* ================================================= */
/* 4. Targets & Categories Section                    */
/* ================================================= */
.targets-section {
    padding: 100px 0;
    background: rgba(19, 27, 46, 0.3);
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title h2 {
    font-size: 36px;
    font-weight: 900;
    margin-bottom: 10px;
}

.section-title p {
    color: var(--text-muted);
    font-size: 16px;
}

.filter-buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
}

.filter-btn {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 8px 20px;
    border-radius: 30px;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition);
}

.filter-btn:hover, .filter-btn.active {
    background: linear-gradient(135deg, var(--primary-red), var(--primary-gold));
    color: white;
    border-color: transparent;
}

.targets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.target-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    transition: var(--transition);
}

.target-card:hover {
    transform: translateY(-8px);
    border-color: var(--primary-gold);
    box-shadow: 0 15px 30px rgba(0,0,0,0.4);
}

